{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./tools/lint/immutable.mjs"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "immutable/no-let": "error",
    "immutable/no-param-reassign": "error",
    "immutable/no-object-assign": "error",
    "curly": ["error", "all"],
    "no-restricted-globals": [
      "error",
      {
        "globals": [{ "name": "Date", "message": "DateではなくTemporalを使用してください。" }],
        "checkGlobalObject": true
      }
    ],
    "typescript/no-restricted-types": [
      "error",
      {
        "types": {
          "unknown": "入力の構造を表す具体的な型を使用し、実行時検証を維持してください。"
        }
      }
    ]
  }
}
