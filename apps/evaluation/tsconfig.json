{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "ES2024.Promise",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable",
      "WebWorker.ImportScripts",
      "ScriptHost"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src", "tests"]
}
