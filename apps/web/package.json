{
  "name": "korekaite-shine-web",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "pnpm --dir ../../packages/api-contracts generate",
    "dev": "pnpm generate && vite --host 127.0.0.1 --port 4327 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4328 --strictPort",
    "verify:http": "node scripts/verify-http.ts",
    "build": "pnpm generate && vite build",
    "typecheck": "pnpm build && tsc --noEmit",
    "test": "pnpm generate && vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@korekaite/api-contracts": "workspace:*",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "void": "1.4.0"
  },
  "engines": {
    "node": ">=26.12.1 <27"
  }
}
