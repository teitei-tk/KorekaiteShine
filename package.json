{
  "name": "korekaite-shine",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "check": "pnpm check:node && pnpm typecheck && pnpm test && pnpm check:docs",
    "check:node": "pnpm --dir tools/docs check:node",
    "typecheck": "pnpm --dir tools/docs typecheck",
    "test": "pnpm --dir tools/docs test",
    "check:docs": "pnpm --dir tools/docs check",
    "check:actions": "gh actions-lock --verify"
  }
}
