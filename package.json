{
  "name": "korekaite-shine",
  "private": true,
  "scripts": {
    "hooks:install": "lefthook install",
    "check:ai-settings": "node tools/ai-review/check-settings.ts",
    "check": "pnpm check:node && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm check:docs",
    "check:node": "pnpm --dir tools/docs check:node",
    "typecheck": "pnpm --dir tools/docs typecheck && pnpm --dir tools/ai-review typecheck",
    "test": "pnpm --dir tools/docs test && pnpm --dir tools/ai-review test",
    "check:docs": "pnpm --dir tools/docs check",
    "check:actions": "gh actions-lock --verify",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check:ai-run": "node tools/ai-review/check-run.ts"
  },
  "devDependencies": {
    "lefthook": "2.2.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0"
  },
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "packageManager": "pnpm@12.15.0"
}
