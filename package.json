{
  "name": "korekaite-shine",
  "private": true,
  "scripts": {
    "hooks:install": "lefthook install",
    "check:ai-settings": "node tools/ai-review/check-settings.ts",
    "check": "pnpm check:node && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm check:docs",
    "check:node": "pnpm --dir tools/docs check:node",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "check:docs": "pnpm --dir tools/docs check",
    "check:actions": "gh actions-lock --verify",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check:ai-run": "node tools/ai-review/check-run.ts",
    "dev:local": "pnpm --filter @korekaite/api-contracts generate && node tools/local-integration/src/run.ts dev",
    "build:local": "pnpm --filter @korekaite/api-contracts generate && node tools/local-integration/src/run.ts build",
    "preview:local": "node tools/local-integration/src/run.ts preview",
    "db:generate": "node tools/local-integration/src/run.ts db:generate",
    "db:migrate": "node tools/local-integration/src/run.ts db:migrate",
    "test:integration": "pnpm --filter @korekaite/api-contracts generate && pnpm --filter @korekaite/local-integration test:integration",
    "db:reset-seed": "node tools/local-integration/src/run.ts db:reset-seed",
    "prepare:integration": "node tools/local-integration/src/prepare-integration.ts",
    "test:integration:pr": "pnpm --filter @korekaite/api-contracts generate && pnpm --filter @korekaite/local-integration test:integration:pr",
    "test:realtime": "pnpm --filter @korekaite/api-contracts generate && pnpm --filter @korekaite/local-integration test:realtime",
    "test:coverage": "pnpm --filter @korekaite/api-contracts generate && pnpm --filter korekaite-shine-api-codegen test && vitest run --config vitest.coverage.config.mts --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "lefthook": "2.2.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.92.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "packageManager": "pnpm@12.15.0"
}
