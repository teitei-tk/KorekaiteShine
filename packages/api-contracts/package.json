{
  "name": "@korekaite/api-contracts",
  "private": true,
  "type": "module",
  "exports": {
    "./http": "./generated/http/api.d.ts",
    "./http/validators": "./generated/http/validators.mjs",
    "./http/openapi": "./generated/http/openapi.json",
    "./events/live-client": "./generated/events/LiveClientEvent.d.ts",
    "./events/live": "./generated/events/LiveServerEvent.d.ts",
    "./events/live-start": "./generated/events/LiveStartEvent.d.ts",
    "./events/validators": "./generated/events/validators.mjs",
    "./messages": "./generated/messages/types.d.ts",
    "./messages/validators": "./generated/messages/validators.mjs",
    "./messages/schema": "./generated/messages/JobNotification.json",
    "./http/diagnostics-validators": "./generated/http/diagnostics-validators.mjs",
    "./http/interviews-validators": "./generated/http/interviews-validators.mjs",
    "./http/materials-validators": "./generated/http/materials-validators.mjs",
    "./http/material-analysis-schema": "./generated/http/material-analysis.schema.json",
    "./http/evaluation-validators": "./generated/http/evaluation-validators.mjs",
    "./http/evaluation-schema": "./generated/http/evaluation.schema.json",
    "./events/interview-client": "./generated/events/InterviewClientEvent.d.ts",
    "./events/interview-server": "./generated/events/InterviewServerEvent.d.ts",
    "./http/application-validators": "./generated/http/application-validators.mjs"
  },
  "scripts": {
    "generate": "tsp compile http/main.tsp --config tspconfig.yaml && pnpm --dir ../../tools/api-codegen generate && node scripts/generate-validation.ts && node scripts/generate-diagnostics-validation.ts && node scripts/generate-materials-validation.ts && node scripts/generate-evaluation-validation.ts && node scripts/generate-interviews-validation.ts && node scripts/generate-application-validation.ts && tsp compile messages/main.tsp --config tspconfig.messages.yaml && node scripts/generate-messages.ts && tsp compile events/live.tsp --config tspconfig.events.yaml && node scripts/generate-events.ts",
    "typecheck": "pnpm generate && tsc --noEmit",
    "test": "pnpm generate && vitest run"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@typespec/compiler": "1.17.0",
    "@typespec/http": "1.17.0",
    "@typespec/json-schema": "1.17.0",
    "@typespec/openapi": "1.17.0",
    "@typespec/openapi3": "1.17.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26.12.1 <27"
  }
}
