{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.Temporal"],
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["*.ts", "isolation/*.ts"]
}
