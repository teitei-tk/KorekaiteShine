{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "ES2024.Promise",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable",
      "WebWorker.ImportScripts",
      "ScriptHost"
    ],
    "module": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "run.ts"]
}
