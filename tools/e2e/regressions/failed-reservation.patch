+
+type Database = ReturnType<typeof createPrimaryDb>;
+export async function reserveAudio(db: Database, input: {
+  reservationId: string; actorId: string; desiredSeconds: number; now: number;
+}): Promise<{ seconds: number; createdAt: number } | null> {
+  if (!Number.isSafeInteger(input.desiredSeconds) || input.desiredSeconds <= 0) { return null; }
+  const day = Temporal.Instant.fromEpochMilliseconds(input.now).toZonedDateTimeISO(usageLimits.timeZone).toPlainDate().toString();
+  await db.run(sql`
+    WITH remaining AS (
+      SELECT MAX(0, ${usageLimits.audioSecondsPerDay} - COALESCE(SUM(${usageReservations.amount}), 0)) AS available
+      FROM ${usageReservations} WHERE ${usageReservations.actorId} = ${input.actorId}
+      AND ${usageReservations.day} = ${day} AND ${usageReservations.kind} = 'audio'
+    )
+    INSERT INTO ${usageReservations} (reservation_id, actor_id, day, kind, amount, created_at)
+    SELECT ${input.reservationId}, ${input.actorId}, ${day}, 'audio', MIN(${input.desiredSeconds}, available), ${input.now}
+    FROM remaining WHERE available > 0
+    ON CONFLICT DO NOTHING
+  `);
+  const [saved] = await db.select().from(usageReservations).where(eq(usageReservations.reservationId, input.reservationId));
+  return saved && saved.actorId === input.actorId && saved.day === day && saved.kind === 'audio' && saved.settledAt === null
+    ? { seconds: saved.amount, createdAt: saved.createdAt } : null;
+}
+
+export async function settleAudio(db: Database, input: {
+  reservationId: string; actorId: string; seconds: number; now: number;
+}): Promise<boolean> {
+  if (!Number.isFinite(input.seconds) || input.seconds < 0 || !Number.isSafeInteger(Math.ceil(input.seconds))) { return false; }
+  const amount = Math.ceil(input.seconds);
+  const match = and(eq(usageReservations.reservationId, input.reservationId), eq(usageReservations.actorId, input.actorId), eq(usageReservations.kind, 'audio'));
+  await db.update(usageReservations).set({ amount, settledAt: input.now }).where(and(match, isNull(usageReservations.settledAt)));
+  const [saved] = await db.select().from(usageReservations).where(match);
+  // 予約を超える上流報告も丸めて隠さず記録し、次回の残枠へ反映する。
+  return Boolean(saved && saved.settledAt !== null && saved.amount === amount);
+}
