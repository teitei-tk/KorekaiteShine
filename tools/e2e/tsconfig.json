{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "Bundler"
  },
  "include": ["bombadil/**/*.ts", "tests/bombadil-*.test.ts"]
}
