{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": ["node"],
    "lib": ["ES2022", "ES2024.Promise", "DOM", "ESNext.Temporal"]
  },
  "include": ["src", "tests", "generated/**/*.d.ts", "generated/**/*.d.mts"]
}
